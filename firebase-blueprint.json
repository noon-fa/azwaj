{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated Azwaj user account record with role and account status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["brother", "scholar", "staff", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended", "deletion_requested"] },
        "emailVerified": { "type": "boolean" },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 4 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "accountStatus", "emailVerified", "countryCode", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "StaffPermission": {
      "title": "StaffPermission",
      "description": "Granular operational permissions for Azwaj staff accounts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "canReviewBrothers": { "type": "boolean" },
        "canManageRequests": { "type": "boolean" },
        "canManageScholars": { "type": "boolean" },
        "canManageBookings": { "type": "boolean" },
        "canViewAuditLogs": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "canReviewBrothers", "canManageRequests", "canManageScholars", "canManageBookings", "canViewAuditLogs", "isActive", "updatedBy", "createdAt", "updatedAt"]
    },
    "BrotherPublicProfile": {
      "title": "BrotherPublicProfile",
      "description": "Public-safe brother marriage introduction directory profile without PII.",
      "type": "object",
      "properties": {
        "brotherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "birthYear": { "type": "integer" },
        "country": { "type": "string", "minLength": 2, "maxLength": 60 },
        "cityDistrict": { "type": "string", "minLength": 2, "maxLength": 80 },
        "nationality": { "type": "string", "minLength": 2, "maxLength": 60 },
        "education": { "type": "string", "minLength": 2, "maxLength": 140 },
        "occupation": { "type": "string", "minLength": 2, "maxLength": 120 },
        "maritalStatus": { "type": "string", "enum": ["never_married", "divorced", "widowed"] },
        "religiousPractice": { "type": "string", "minLength": 10, "maxLength": 600 },
        "languages": { "type": "array" },
        "marriagePreferences": { "type": "string", "minLength": 10, "maxLength": 800 },
        "about": { "type": "string", "minLength": 20, "maxLength": 1200 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "showPhotoPublicly": { "type": "boolean" },
        "consentToPublish": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending_review", "changes_requested", "approved", "rejected", "suspended"] },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brotherId", "displayName", "birthYear", "country", "cityDistrict", "nationality", "education", "occupation", "maritalStatus", "religiousPractice", "languages", "marriagePreferences", "about", "showPhotoPublicly", "consentToPublish", "status", "isPublished", "createdAt", "updatedAt"]
    },
    "BrotherPrivateDetail": {
      "title": "BrotherPrivateDetail",
      "description": "Strictly isolated PII and moderation notes for a registered brother.",
      "type": "object",
      "properties": {
        "brotherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "dateOfBirth": { "type": "string", "minLength": 8, "maxLength": 20 },
        "adminReviewNote": { "type": "string", "maxLength": 800 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brotherId", "fullName", "email", "phone", "dateOfBirth", "createdAt", "updatedAt"]
    },
    "MarriageRequest": {
      "title": "MarriageRequest",
      "description": "Private wali-mediated marriage introduction request.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lockId": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "brotherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "brotherDisplayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "waliName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "waliRelationship": { "type": "string", "minLength": 2, "maxLength": 60 },
        "waliEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "normalizedWaliEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "waliPhone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "waliCountry": { "type": "string", "minLength": 2, "maxLength": 60 },
        "waliCityDistrict": { "type": "string", "minLength": 2, "maxLength": 80 },
        "sisterName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "sisterAge": { "type": "integer" },
        "sisterCountry": { "type": "string", "minLength": 2, "maxLength": 60 },
        "sisterCityDistrict": { "type": "string", "minLength": 2, "maxLength": 80 },
        "sisterEducation": { "type": "string", "minLength": 2, "maxLength": 140 },
        "sisterOccupation": { "type": "string", "maxLength": 120 },
        "sisterLanguages": { "type": "array" },
        "sisterMarriageInfo": { "type": "string", "minLength": 10, "maxLength": 800 },
        "sisterNote": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "additionalMessage": { "type": "string", "maxLength": 800 },
        "confirmedWaliAuthority": { "type": "boolean" },
        "privacyConsent": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "expired"] },
        "responseDeadlineAt": { "type": "string", "format": "date-time" },
        "respondedAt": { "type": "string", "format": "date-time" },
        "contactSharingStatus": { "type": "string", "enum": ["locked", "wali_contact_released", "exchanged"] },
        "brotherSharedContact": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "lockId", "brotherId", "brotherDisplayName", "waliName", "waliRelationship", "waliEmail", "normalizedWaliEmail", "waliPhone", "waliCountry", "waliCityDistrict", "sisterName", "sisterAge", "sisterCountry", "sisterCityDistrict", "sisterEducation", "sisterLanguages", "sisterMarriageInfo", "sisterNote", "confirmedWaliAuthority", "privacyConsent", "status", "responseDeadlineAt", "contactSharingStatus", "createdAt", "updatedAt"]
    },
    "MarriageRequestLock": {
      "title": "MarriageRequestLock",
      "description": "Deterministic duplicate prevention lock for brotherId + normalizedWaliEmail.",
      "type": "object",
      "properties": {
        "lockId": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "brotherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "activeRequestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lockId", "brotherId", "activeRequestId", "status", "createdAt", "updatedAt"]
    },
    "ScholarProfile": {
      "title": "ScholarProfile",
      "description": "Azwaj-appointed Islamic scholar (Alim or Alimah) profile.",
      "type": "object",
      "properties": {
        "scholarId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 60 },
        "qualification": { "type": "string", "minLength": 2, "maxLength": 160 },
        "education": { "type": "string", "minLength": 5, "maxLength": 300 },
        "expertise": { "type": "array" },
        "languages": { "type": "array" },
        "biography": { "type": "string", "minLength": 20, "maxLength": 1500 },
        "experienceYears": { "type": "integer" },
        "counsellingFormats": { "type": "array" },
        "counsellingTypes": { "type": "array" },
        "sessionDurationMinutes": { "type": "integer" },
        "sessionPriceLkr": { "type": "integer" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 5 },
        "country": { "type": "string", "minLength": 2, "maxLength": 60 },
        "cityLocation": { "type": "string", "maxLength": 120 },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 60 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scholarId", "fullName", "gender", "title", "qualification", "education", "expertise", "languages", "biography", "experienceYears", "counsellingFormats", "counsellingTypes", "sessionDurationMinutes", "sessionPriceLkr", "currency", "country", "timezone", "isActive", "createdAt", "updatedAt"]
    },
    "ScholarAvailability": {
      "title": "ScholarAvailability",
      "description": "Scholar working hours, breaks, and blocked dates.",
      "type": "object",
      "properties": {
        "scholarId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scholarUid": { "type": "string", "maxLength": 128 },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 60 },
        "weeklyHours": { "type": "object" },
        "breaks": { "type": "array" },
        "unavailableDates": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scholarId", "timezone", "weeklyHours", "breaks", "unavailableDates", "createdAt", "updatedAt"]
    },
    "CounsellingSlotLock": {
      "title": "CounsellingSlotLock",
      "description": "Zero-PII slot lock preventing concurrent double bookings.",
      "type": "object",
      "properties": {
        "slotLockId": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scholarId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slotStartIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "slotEndIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "status": { "type": "string", "enum": ["booked", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slotLockId", "scholarId", "bookingId", "slotStartIso", "slotEndIso", "status", "createdAt", "updatedAt"]
    },
    "CounsellingBooking": {
      "title": "CounsellingBooking",
      "description": "Confidential Islamic counselling session booking isolated from marriage records.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slotLockId": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scholarId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scholarUid": { "type": "string", "maxLength": 128 },
        "scholarName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "counsellingType": { "type": "string", "enum": ["pre_marital", "married_couples", "individual"] },
        "format": { "type": "string", "enum": ["online", "in_person"] },
        "slotStartIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "slotEndIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 60 },
        "durationMinutes": { "type": "integer" },
        "sessionPriceLkr": { "type": "integer" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 5 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "clientPhone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "issueSummary": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["confirmed", "completed", "cancelled_by_client", "cancelled_by_scholar", "cancelled_by_admin"] },
        "paymentStatus": { "type": "string", "enum": ["payment_not_enabled"] },
        "cancellationReason": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "slotLockId", "scholarId", "scholarName", "counsellingType", "format", "slotStartIso", "slotEndIso", "timezone", "durationMinutes", "sessionPriceLkr", "currency", "clientName", "clientEmail", "clientPhone", "issueSummary", "status", "paymentStatus", "createdAt", "updatedAt"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Public contact message or report submitted to Azwaj staff.",
      "type": "object",
      "properties": {
        "inquiryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "topic": { "type": "string", "minLength": 2, "maxLength": 80 },
        "message": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["new", "reviewed", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inquiryId", "name", "email", "topic", "message", "status", "createdAt", "updatedAt"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "Transactional email queue and notification audit record.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "minLength": 2, "maxLength": 80 },
        "recipientEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "status": { "type": "string", "enum": ["queued", "sent", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "type", "recipientEmail", "subject", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit trail record.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "action": { "type": "string", "minLength": 2, "maxLength": 100 },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 3, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "actorUid", "actorEmail", "action", "targetCollection", "targetId", "summary", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Country-specific and platform-wide configuration.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 4 },
        "countryName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "defaultCurrency": { "type": "string", "minLength": 3, "maxLength": 5 },
        "defaultTimezone": { "type": "string", "minLength": 3, "maxLength": 60 },
        "requestExpiryDays": { "type": "integer" },
        "paymentsEnabled": { "type": "boolean" },
        "emailProvider": { "type": "string", "enum": ["resend", "smtp", "disabled"] },
        "supportEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settingId", "countryCode", "countryName", "defaultCurrency", "defaultTimezone", "requestExpiryDays", "paymentsEnabled", "emailProvider", "supportEmail", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user account records with RBAC role."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup collection."
    },
    "/staffPermissions/{userId}": {
      "schema": { "$ref": "#/entities/StaffPermission" },
      "description": "Granular permission flags for Azwaj staff."
    },
    "/brotherProfiles/{brotherId}": {
      "schema": { "$ref": "#/entities/BrotherPublicProfile" },
      "description": "Public-safe brother profiles; only approved & published visible publicly."
    },
    "/brotherPrivateDetails/{brotherId}": {
      "schema": { "$ref": "#/entities/BrotherPrivateDetail" },
      "description": "Isolated brother PII and moderation notes."
    },
    "/marriageRequests/{requestId}": {
      "schema": { "$ref": "#/entities/MarriageRequest" },
      "description": "Private wali-mediated introduction requests."
    },
    "/marriageRequestLocks/{lockId}": {
      "schema": { "$ref": "#/entities/MarriageRequestLock" },
      "description": "Deterministic duplicate request lock per brother + normalized wali email."
    },
    "/scholars/{scholarId}": {
      "schema": { "$ref": "#/entities/ScholarProfile" },
      "description": "Public directory of Azwaj-appointed scholars (Alims & Alimahs)."
    },
    "/scholarAvailability/{scholarId}": {
      "schema": { "$ref": "#/entities/ScholarAvailability" },
      "description": "Scholar weekly hours, breaks, and blocked dates."
    },
    "/counsellingSlotLocks/{slotLockId}": {
      "schema": { "$ref": "#/entities/CounsellingSlotLock" },
      "description": "Zero-PII counselling slot reservation locks."
    },
    "/counsellingBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/CounsellingBooking" },
      "description": "Confidential counselling bookings isolated from marriage records."
    },
    "/contactInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Public contact inquiries and moderation reports."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "Server-side email dispatch log and queue."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Country and platform settings."
    }
  }
}
