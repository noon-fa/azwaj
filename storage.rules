rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Brother profile photos: owner can upload/delete, public can read approved photo URLs
    match /brothers/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isEmailVerified()
        && request.auth.uid == userId
        && fileName.matches('^[a-zA-Z0-9_\\-\\.]{1,120}$')
        && isValidImageUpload();
      allow delete: if isEmailVerified() && request.auth.uid == userId;
    }

    // Scholar profile photos: managed by authenticated admin/staff or Cloud Functions
    match /scholars/{scholarId}/profile/{fileName} {
      allow read: if true;
      allow write: if isEmailVerified()
        && request.auth.token.email == 'itsmefminsaf@gmail.com'
        && fileName.matches('^[a-zA-Z0-9_\\-\\.]{1,120}$')
        && isValidImageUpload();
    }
  }
}
